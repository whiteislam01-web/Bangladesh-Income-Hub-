# ============================================================
# BDIH (Bangladesh Income Hub) — Environment Configuration Template
# ============================================================
# Copy this file to .env for local development.
# In production, configure these variables in your hosting environment.
# NEVER commit real secret keys, service role keys, or passwords to git.
# ============================================================

# ------------------------------------------------------------
# 1. CLIENT-SIDE SUPABASE CONFIGURATION (Safe for browser / VITE_)
# ------------------------------------------------------------
# Your unique Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Publishable / Anon API Key (Used for client queries and user-level auth)
# Safe to expose in the browser; protected by Row Level Security (RLS) policies
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# ------------------------------------------------------------
# 2. SERVER-SIDE PRIVILEGED SECRETS (STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------
# CRITICAL: NEVER prefix this with VITE_ or expose it to the browser bundle.
# The Service Role Key bypasses RLS and is used exclusively by server.ts for:
# - Admin payment verification & entitlement provisioning
# - Time-limited signed URL generation for private course materials
# - Privileged administrative operations
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# Server Port (Defaults to 3000)
PORT=3000

# Application Environment ('development' | 'production')
NODE_ENV="development"

# ------------------------------------------------------------
# 3. PLATFORM & OAUTH REDIRECT CONFIGURATION
# ------------------------------------------------------------
# The public URL where this applet is hosted (used for OAuth redirect callbacks)
APP_URL="https://bdih.com"

# Gemini AI API Key (Injected automatically in AI Studio runtime)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
